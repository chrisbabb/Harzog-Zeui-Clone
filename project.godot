[layer_names]

2d_physics/layer_1="ground_units"
2d_physics/layer_2="air_units"
2d_physics/layer_3="buildings"
2d_physics/layer_4="projectiles"
2d_physics/layer_5="player_1"
2d_physics/layer_6="player_2"
2d_physics/layer_7="player_3"
2d_physics/layer_8="player_4"

[rendering]

